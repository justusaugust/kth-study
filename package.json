{
  "name": "kth-study-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch src/server/main.ts --root . --port 4318\"",
    "dev:api": "tsx watch src/server/main.ts --root . --port 4318",
    "build": "tsc --noEmit && vite build && pnpm build:plugin && pnpm build:api",
    "build:api": "tsup src/vercel.ts --format esm --platform node --target node24 --out-dir server-build",
    "build:plugin": "tsx scripts/build-plugin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "index:content": "tsx scripts/build-search-index.ts"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.119.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solar-icons/react": "^2.1.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.4",
    "katex": "^0.18.4",
    "mafs": "^0.21.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
